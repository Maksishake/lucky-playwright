{
  "name": "lucky-playwright",
  "version": "1.0.0",
  "description": "Playwright E2E Testing Framework for Lucky Casino",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:critical": "playwright test --grep @critical",
    "test:auth": "playwright test tests/ui/auth",
    "test:wallet": "playwright test tests/ui/wallet",
    "test:components": "playwright test tests/components",
    "test:modals": "playwright test tests/components/modals",
    "test:support": "playwright test tests/pages/support",
    "test:list": "playwright test --list",
    "test:install": "playwright install --with-deps",
    "test:codegen": "playwright codegen",
    "test:trace": "playwright show-trace",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\""
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "automation"
  ],
  "author": "Lucky Team",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^20.0.0",
    "dotenv": "^17.2.3",
    "playwright": "^1.55.1",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
